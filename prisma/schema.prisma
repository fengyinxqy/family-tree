generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  persons      Person[]
  familyTrees  FamilyTree[]

  @@map("users")
}

model FamilyTree {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  persons     Person[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerId, createdAt], map: "idx_family_trees_owner_created")
  @@map("family_trees")
}

model Person {
  id              String         @id @default(cuid())
  name            String
  gender          String // "male" | "female"
  birthDate       String?        @map("birth_date")
  deathDate       String?        @map("death_date")
  bio             String?
  aliases         String[]       @default([])
  generationNumber Int           @default(1) @map("generation_number")
  generationLabel String?        @map("generation_label")
  nativePlace     String?        @map("native_place")
  notes           String?
  posX            Float?         @map("pos_x")
  posY            Float?         @map("pos_y")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  createdBy       String         @map("created_by")
  creator         User           @relation(fields: [createdBy], references: [id])
  treeId          String         @map("tree_id")
  tree            FamilyTree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  relationsA      Relationship[] @relation("PersonA")
  relationsB      Relationship[] @relation("PersonB")
  events          PersonEvent[]

  @@index([createdBy, treeId], map: "idx_persons_created_by_tree")
  @@map("persons")
}

model PersonEvent {
  id          String   @id @default(cuid())
  personId    String   @map("person_id")
  type        String // "birth" | "death" | "marriage" | "migration" | "other"
  title       String?
  dateLabel   String?  @map("date_label")
  location    String?
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, sortOrder], map: "idx_person_events_person_sort")
  @@map("person_events")
}

model Relationship {
  id        String   @id @default(cuid())
  type      String // "spouse" | "child"
  personAId String   @map("person_a_id")
  personBId String   @map("person_b_id")
  label     String?  @map("label")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  personA   Person   @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personB   Person   @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)

  @@map("relationships")
}
