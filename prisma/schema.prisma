generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  name                      String
  passwordHash              String               @map("password_hash")
  createdAt                 DateTime             @default(now()) @map("created_at")
  persons                   Person[]
  familyTrees               FamilyTree[]
  sourceMaterials           SourceMaterial[]
  familyMemberships         FamilyMembership[]
  sentFamilyInvitations     FamilyInvitation[]   @relation("FamilyInvitationInviter")
  acceptedFamilyInvitations FamilyInvitation[]   @relation("FamilyInvitationAcceptor")
  authoredContentRevisions  ContentRevision[]    @relation("ContentRevisionAuthor")
  publishedContentRevisions ContentRevision[]    @relation("ContentRevisionPublisher")
  withdrawnContentRevisions ContentRevision[]    @relation("ContentRevisionWithdrawer")
  authoredRevisionGroups    RevisionGroup[]      @relation("RevisionGroupAuthor")
  publishedRevisionGroups   RevisionGroup[]      @relation("RevisionGroupPublisher")
  reviewDecisions           ReviewDecision[]
  provenanceEntries         RevisionProvenance[]
  stagedMediaUploads        StagedMediaUpload[]
  agentSessions             AgentSession[]
  agentMessages             AgentMessage[]
  agentRuns                 AgentRun[]

  @@map("users")
}

model FamilyTree {
  id                 String                  @id @default(cuid())
  name               String
  description        String?
  ownerId            String                  @map("owner_id")
  owner              User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  persons            Person[]
  dataRevision       Int                     @default(0) @map("data_revision")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  operationBatches   OperationBatch[]
  confirmations      OperationConfirmation[]
  snapshots          FamilySnapshot[]
  sourceMaterials    SourceMaterial[]
  memberships        FamilyMembership[]
  invitations        FamilyInvitation[]
  contentRevisions   ContentRevision[]
  revisionGroups     RevisionGroup[]
  provenanceEntries  RevisionProvenance[]
  stagedMediaUploads StagedMediaUpload[]
  agentSessions      AgentSession[]

  @@index([ownerId, createdAt], map: "idx_family_trees_owner_created")
  @@map("family_trees")
}

enum FamilyRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum FamilyMembershipStatus {
  ACTIVE
  SUSPENDED
}

enum FamilyInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model FamilyMembership {
  id        String                 @id @default(cuid())
  treeId    String                 @map("tree_id")
  tree      FamilyTree             @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId    String                 @map("user_id")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      FamilyRole
  status    FamilyMembershipStatus @default(ACTIVE)
  joinedAt  DateTime               @default(now()) @map("joined_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@unique([treeId, userId], map: "uq_family_memberships_tree_user")
  @@index([userId, status], map: "idx_family_memberships_user_status")
  @@index([treeId, role, status], map: "idx_family_memberships_tree_role_status")
  @@map("family_memberships")
}

model FamilyInvitation {
  id             String                 @id @default(cuid())
  treeId         String                 @map("tree_id")
  tree           FamilyTree             @relation(fields: [treeId], references: [id], onDelete: Cascade)
  email          String
  role           FamilyRole
  tokenHash      String                 @unique @map("token_hash")
  status         FamilyInvitationStatus @default(PENDING)
  expiresAt      DateTime               @map("expires_at")
  invitedBy      String                 @map("invited_by")
  inviter        User                   @relation("FamilyInvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  acceptedBy     String?                @map("accepted_by")
  acceptedByUser User?                  @relation("FamilyInvitationAcceptor", fields: [acceptedBy], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?              @map("accepted_at")
  revokedAt      DateTime?              @map("revoked_at")
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([treeId, status, createdAt], map: "idx_family_invitations_tree_status_created")
  @@index([email, status, expiresAt], map: "idx_family_invitations_email_status_expiry")
  @@map("family_invitations")
}

enum RevisionContentType {
  PERSON
  PERSON_EVENT
  RELATIONSHIP
  SOURCE_MATERIAL
  MEDIA_OBJECT
  MATERIAL_LINK
  IMPORT_BATCH
}

enum ContentRevisionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
}

enum ReviewDecisionType {
  APPROVED
  CHANGES_REQUESTED
}

enum RevisionProvenanceKind {
  MATERIAL
  MEDIA_OBJECT
  INTAKE_SNAPSHOT
  MANUAL_KNOWLEDGE
}

model ContentRevision {
  id                    String                @id @default(cuid())
  treeId                String                @map("tree_id")
  tree                  FamilyTree            @relation(fields: [treeId], references: [id], onDelete: Cascade)
  contentType           RevisionContentType   @map("content_type")
  targetEntityId        String?               @map("target_entity_id")
  authorId              String                @map("author_id")
  author                User                  @relation("ContentRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parentRevisionId      String?               @map("parent_revision_id")
  parentRevision        ContentRevision?      @relation("RevisionHistory", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  derivedRevisions      ContentRevision[]     @relation("RevisionHistory")
  baseFamilyRevision    Int                   @map("base_family_revision")
  baseTargetUpdatedAt   DateTime?             @map("base_target_updated_at")
  schemaVersion         Int                   @default(1) @map("schema_version")
  version               Int                   @default(1)
  status                ContentRevisionStatus @default(DRAFT)
  payload               Json
  submittedAt           DateTime?             @map("submitted_at")
  approvedAt            DateTime?             @map("approved_at")
  publishedAt           DateTime?             @map("published_at")
  publishedBy           String?               @map("published_by")
  publisher             User?                 @relation("ContentRevisionPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)
  publishOperationId    String?               @map("publish_operation_id")
  withdrawnAt           DateTime?             @map("withdrawn_at")
  withdrawnBy           String?               @map("withdrawn_by")
  withdrawer            User?                 @relation("ContentRevisionWithdrawer", fields: [withdrawnBy], references: [id], onDelete: SetNull)
  withdrawalReason      String?               @map("withdrawal_reason")
  withdrawalOperationId String?               @map("withdrawal_operation_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  reviewDecisions       ReviewDecision[]
  groupMembership       RevisionGroupMember?
  provenanceEntries     RevisionProvenance[]

  @@index([treeId, status, submittedAt], map: "idx_content_revisions_review_queue")
  @@index([treeId, contentType, targetEntityId, createdAt], map: "idx_content_revisions_target_history")
  @@index([authorId, status, updatedAt], map: "idx_content_revisions_author_status")
  @@index([parentRevisionId], map: "idx_content_revisions_parent")
  @@map("content_revisions")
}

model RevisionGroup {
  id                 String                @id @default(cuid())
  treeId             String                @map("tree_id")
  tree               FamilyTree            @relation(fields: [treeId], references: [id], onDelete: Cascade)
  authorId           String                @map("author_id")
  author             User                  @relation("RevisionGroupAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  schemaVersion      Int                   @default(1) @map("schema_version")
  summary            String
  sourceSnapshot     Json                  @map("source_snapshot")
  sourceTextHash     String                @map("source_text_hash")
  safeSourceExcerpt  String                @map("safe_source_excerpt")
  baseFamilyRevision Int                   @map("base_family_revision")
  status             ContentRevisionStatus @default(DRAFT)
  submittedAt        DateTime?             @map("submitted_at")
  approvedAt         DateTime?             @map("approved_at")
  publishedAt        DateTime?             @map("published_at")
  publishedBy        String?               @map("published_by")
  publisher          User?                 @relation("RevisionGroupPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)
  publishOperationId String?               @map("publish_operation_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  members            RevisionGroupMember[]
  reviewDecisions    ReviewDecision[]
  provenanceEntries  RevisionProvenance[]

  @@index([treeId, status, submittedAt], map: "idx_revision_groups_review_queue")
  @@index([authorId, status, updatedAt], map: "idx_revision_groups_author_status")
  @@index([treeId, createdAt], map: "idx_revision_groups_tree_created")
  @@map("revision_groups")
}

model RevisionGroupMember {
  id         String          @id @default(cuid())
  groupId    String          @map("group_id")
  group      RevisionGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  revisionId String          @unique @map("revision_id")
  revision   ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  order      Int
  tempRef    String          @map("temp_ref")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([groupId, order], map: "uq_revision_group_members_order")
  @@unique([groupId, tempRef], map: "uq_revision_group_members_temp_ref")
  @@index([groupId, createdAt], map: "idx_revision_group_members_group_created")
  @@map("revision_group_members")
}

model ReviewDecision {
  id             String             @id @default(cuid())
  revisionId     String?            @map("revision_id")
  revision       ContentRevision?   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  groupId        String?            @map("group_id")
  group          RevisionGroup?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reviewerId     String             @map("reviewer_id")
  reviewer       User               @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision       ReviewDecisionType
  comment        String?
  overrideReason String?            @map("override_reason")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([revisionId, createdAt], map: "idx_review_decisions_revision_created")
  @@index([groupId, createdAt], map: "idx_review_decisions_group_created")
  @@index([reviewerId, createdAt], map: "idx_review_decisions_reviewer_created")
  @@map("review_decisions")
}

model RevisionProvenance {
  id               String                 @id @default(cuid())
  treeId           String                 @map("tree_id")
  tree             FamilyTree             @relation(fields: [treeId], references: [id], onDelete: Cascade)
  revisionId       String?                @map("revision_id")
  revision         ContentRevision?       @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  groupId          String?                @map("group_id")
  group            RevisionGroup?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind             RevisionProvenanceKind
  sourceMaterialId String?                @map("source_material_id")
  sourceMaterial   SourceMaterial?        @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  mediaObjectId    String?                @map("media_object_id")
  mediaObject      MediaObject?           @relation(fields: [mediaObjectId], references: [id], onDelete: SetNull)
  locator          String?
  sourceTextHash   String?                @map("source_text_hash")
  safeExcerpt      String?                @map("safe_excerpt")
  manualRationale  String?                @map("manual_rationale")
  safeSourceLabel  String                 @map("safe_source_label")
  createdBy        String                 @map("created_by")
  creator          User                   @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now()) @map("created_at")

  @@index([treeId, createdAt], map: "idx_revision_provenance_tree_created")
  @@index([revisionId, createdAt], map: "idx_revision_provenance_revision_created")
  @@index([groupId, createdAt], map: "idx_revision_provenance_group_created")
  @@index([sourceMaterialId], map: "idx_revision_provenance_material")
  @@index([mediaObjectId], map: "idx_revision_provenance_media")
  @@map("revision_provenance")
}

model StagedMediaUpload {
  id           String     @id @default(cuid())
  treeId       String     @map("tree_id")
  tree         FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  uploadedBy   String     @map("uploaded_by")
  uploader     User       @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  temporaryKey String     @unique @map("temporary_key")
  originalName String     @map("original_name")
  mimeType     String     @map("mime_type")
  byteSize     Int        @map("byte_size")
  contentHash  String     @map("content_hash")
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([treeId, consumedAt, expiresAt], map: "idx_staged_media_uploads_tree_state")
  @@index([uploadedBy, createdAt], map: "idx_staged_media_uploads_uploader_created")
  @@map("staged_media_uploads")
}

enum AgentSessionStatus {
  ACTIVE
  ARCHIVED
}

enum AgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentRunStatus {
  PENDING
  RUNNING
  WAITING_FOR_USER
  WAITING_FOR_CONFIRMATION
  COMPLETED
  FAILED
  CANCELLED
  BUDGET_EXHAUSTED
}

enum AgentStepStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AgentToolCallStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REJECTED
}

enum AgentToolSideEffect {
  READ
  PROPOSE
}

model AgentSession {
  id           String             @id @default(cuid())
  treeId       String             @map("tree_id")
  tree         FamilyTree         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  createdBy    String             @map("created_by")
  creator      User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  agentType    String             @map("agent_type")
  title        String
  status       AgentSessionStatus @default(ACTIVE)
  currentRunId String?            @unique @map("current_run_id")
  currentRun   AgentRun?          @relation("AgentSessionCurrentRun", fields: [currentRunId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  messages     AgentMessage[]
  runs         AgentRun[]         @relation("AgentSessionRuns")

  @@index([treeId, createdBy, updatedAt], map: "idx_agent_sessions_tree_creator_updated")
  @@index([treeId, status, updatedAt], map: "idx_agent_sessions_tree_status_updated")
  @@map("agent_sessions")
}

model AgentMessage {
  id        String           @id @default(cuid())
  sessionId String           @map("session_id")
  session   AgentSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId  String?          @map("author_id")
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  role      AgentMessageRole
  content   String
  sequence  Int
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([sessionId, sequence], map: "uq_agent_messages_session_sequence")
  @@index([sessionId, createdAt], map: "idx_agent_messages_session_created")
  @@map("agent_messages")
}

model AgentRun {
  id                String          @id @default(cuid())
  sessionId         String          @map("session_id")
  session           AgentSession    @relation("AgentSessionRuns", fields: [sessionId], references: [id], onDelete: Cascade)
  currentForSession AgentSession[]  @relation("AgentSessionCurrentRun")
  initiatedBy       String          @map("initiated_by")
  initiator         User            @relation(fields: [initiatedBy], references: [id], onDelete: Restrict)
  goal              String
  status            AgentRunStatus  @default(PENDING)
  budget            Json
  usage             Json            @default("{}")
  provider          String
  model             String
  promptVersion     String          @map("prompt_version")
  graphVersion      String          @map("graph_version")
  toolSchemaVersion String          @map("tool_schema_version")
  stateVersion      Int             @default(1) @map("state_version")
  interruption      Json?
  result            Json?
  terminationReason String?         @map("termination_reason")
  errorCategory     String?         @map("error_category")
  errorMessage      String?         @map("error_message")
  startedAt         DateTime?       @map("started_at")
  endedAt           DateTime?       @map("ended_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  steps             AgentStep[]
  toolCalls         AgentToolCall[]

  @@index([sessionId, status, createdAt], map: "idx_agent_runs_session_status_created")
  @@index([initiatedBy, createdAt], map: "idx_agent_runs_initiator_created")
  @@map("agent_runs")
}

model AgentStep {
  id            String          @id @default(cuid())
  runId         String          @map("run_id")
  run           AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence      Int
  node          String
  status        AgentStepStatus @default(RUNNING)
  inputSummary  Json            @default("{}") @map("input_summary")
  outputSummary Json            @default("{}") @map("output_summary")
  durationMs    Int?            @map("duration_ms")
  inputTokens   Int?            @map("input_tokens")
  outputTokens  Int?            @map("output_tokens")
  errorCategory String?         @map("error_category")
  createdAt     DateTime        @default(now()) @map("created_at")
  completedAt   DateTime?       @map("completed_at")
  toolCalls     AgentToolCall[]

  @@unique([runId, sequence], map: "uq_agent_steps_run_sequence")
  @@index([runId, createdAt], map: "idx_agent_steps_run_created")
  @@map("agent_steps")
}

model AgentToolCall {
  id               String              @id @default(cuid())
  runId            String              @map("run_id")
  run              AgentRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId           String?             @map("step_id")
  step             AgentStep?          @relation(fields: [stepId], references: [id], onDelete: SetNull)
  toolName         String              @map("tool_name")
  toolVersion      String              @map("tool_version")
  sideEffect       AgentToolSideEffect @map("side_effect")
  status           AgentToolCallStatus @default(PENDING)
  idempotencyKey   String              @unique @map("idempotency_key")
  argumentsHash    String              @map("arguments_hash")
  argumentsSummary Json                @default("{}") @map("arguments_summary")
  resultSummary    Json                @default("{}") @map("result_summary")
  permissionAction String              @map("permission_action")
  permissionResult String?             @map("permission_result")
  durationMs       Int?                @map("duration_ms")
  errorCategory    String?             @map("error_category")
  errorMessage     String?             @map("error_message")
  createdAt        DateTime            @default(now()) @map("created_at")
  completedAt      DateTime?           @map("completed_at")

  @@index([runId, createdAt], map: "idx_agent_tool_calls_run_created")
  @@index([stepId], map: "idx_agent_tool_calls_step")
  @@map("agent_tool_calls")
}

// LangGraph owns the contents and migrations of these checkpoint tables.
// They are represented here so future Prisma migrations preserve them.
model LangGraphCheckpointMigration {
  version Int @id @map("v")

  @@map("checkpoint_migrations")
}

model LangGraphCheckpoint {
  threadId           String  @map("thread_id")
  checkpointNs       String  @default("") @map("checkpoint_ns")
  checkpointId       String  @map("checkpoint_id")
  parentCheckpointId String? @map("parent_checkpoint_id")
  type               String?
  checkpoint         Json
  metadata           Json    @default("{}")

  @@id([threadId, checkpointNs, checkpointId])
  @@map("checkpoints")
}

model LangGraphCheckpointBlob {
  threadId     String @map("thread_id")
  checkpointNs String @default("") @map("checkpoint_ns")
  channel      String
  version      String
  type         String
  blob         Bytes?

  @@id([threadId, checkpointNs, channel, version])
  @@map("checkpoint_blobs")
}

model LangGraphCheckpointWrite {
  threadId     String  @map("thread_id")
  checkpointNs String  @default("") @map("checkpoint_ns")
  checkpointId String  @map("checkpoint_id")
  taskId       String  @map("task_id")
  index        Int     @map("idx")
  channel      String
  type         String?
  blob         Bytes

  @@id([threadId, checkpointNs, checkpointId, taskId, index])
  @@map("checkpoint_writes")
}

model Person {
  id                    String         @id @default(cuid())
  name                  String
  gender                String
  birthDate             String?        @map("birth_date")
  deathDate             String?        @map("death_date")
  bio                   String?
  aliases               String[]       @default([])
  generationNumber      Int            @default(1) @map("generation_number")
  generationLabel       String?        @map("generation_label")
  nativePlace           String?        @map("native_place")
  notes                 String?
  posX                  Float?         @map("pos_x")
  posY                  Float?         @map("pos_y")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  createdBy             String         @map("created_by")
  creator               User           @relation(fields: [createdBy], references: [id])
  treeId                String         @map("tree_id")
  tree                  FamilyTree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  relationsA            Relationship[] @relation("PersonA")
  relationsB            Relationship[] @relation("PersonB")
  events                PersonEvent[]
  deletedAt             DateTime?      @map("deleted_at")
  deletedBy             String?        @map("deleted_by")
  deletionOperationId   String?        @map("deletion_operation_id")
  withdrawnAt           DateTime?      @map("withdrawn_at")
  withdrawnBy           String?        @map("withdrawn_by")
  withdrawalReason      String?        @map("withdrawal_reason")
  withdrawalOperationId String?        @map("withdrawal_operation_id")
  materialLinks         MaterialLink[]

  @@index([createdBy, treeId], map: "idx_persons_created_by_tree")
  @@index([treeId, deletedAt], map: "idx_persons_tree_deleted")
  @@index([treeId, withdrawnAt], map: "idx_persons_tree_withdrawn")
  @@map("persons")
}

model PersonEvent {
  id                    String         @id @default(cuid())
  personId              String         @map("person_id")
  type                  String
  title                 String?
  dateLabel             String?        @map("date_label")
  location              String?
  description           String?
  sortOrder             Int            @default(0) @map("sort_order")
  createdAt             DateTime       @default(now()) @map("created_at")
  person                Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  materialLinks         MaterialLink[]
  withdrawnAt           DateTime?      @map("withdrawn_at")
  withdrawnBy           String?        @map("withdrawn_by")
  withdrawalReason      String?        @map("withdrawal_reason")
  withdrawalOperationId String?        @map("withdrawal_operation_id")

  @@index([personId, sortOrder], map: "idx_person_events_person_sort")
  @@index([personId, withdrawnAt], map: "idx_person_events_person_withdrawn")
  @@map("person_events")
}

enum MaterialCategory {
  genealogy
  document
  photo
  certificate
  oral_history
  other
}

model SourceMaterial {
  id                    String               @id @default(cuid())
  treeId                String               @map("tree_id")
  tree                  FamilyTree           @relation(fields: [treeId], references: [id], onDelete: Cascade)
  title                 String
  category              MaterialCategory
  source                String?
  eraLabel              String?              @map("era_label")
  contributor           String?
  description           String?
  createdBy             String               @map("created_by")
  creator               User                 @relation(fields: [createdBy], references: [id])
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  deletedAt             DateTime?            @map("deleted_at")
  deletedBy             String?              @map("deleted_by")
  deletionOperationId   String?              @map("deletion_operation_id")
  withdrawnAt           DateTime?            @map("withdrawn_at")
  withdrawnBy           String?              @map("withdrawn_by")
  withdrawalReason      String?              @map("withdrawal_reason")
  withdrawalOperationId String?              @map("withdrawal_operation_id")
  files                 MediaObject[]
  links                 MaterialLink[]
  provenanceEntries     RevisionProvenance[]

  @@index([treeId, deletedAt, createdAt], map: "idx_source_materials_tree_active_created")
  @@index([createdBy, treeId], map: "idx_source_materials_creator_tree")
  @@index([treeId, withdrawnAt], map: "idx_source_materials_tree_withdrawn")
  @@map("source_materials")
}

model MediaObject {
  id                    String               @id @default(cuid())
  materialId            String               @map("material_id")
  material              SourceMaterial       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  originalName          String               @map("original_name")
  mimeType              String               @map("mime_type")
  byteSize              Int                  @map("byte_size")
  contentHash           String               @map("content_hash")
  storageKey            String               @unique @map("storage_key")
  displayOrder          Int                  @default(0) @map("display_order")
  createdAt             DateTime             @default(now()) @map("created_at")
  deletedAt             DateTime?            @map("deleted_at")
  deletedBy             String?              @map("deleted_by")
  deletionOperationId   String?              @map("deletion_operation_id")
  withdrawnAt           DateTime?            @map("withdrawn_at")
  withdrawnBy           String?              @map("withdrawn_by")
  withdrawalReason      String?              @map("withdrawal_reason")
  withdrawalOperationId String?              @map("withdrawal_operation_id")
  provenanceEntries     RevisionProvenance[]

  @@index([materialId, deletedAt, displayOrder], map: "idx_media_objects_material_active_order")
  @@index([contentHash], map: "idx_media_objects_hash")
  @@index([materialId, withdrawnAt], map: "idx_media_objects_material_withdrawn")
  @@map("media_objects")
}

model MaterialLink {
  id                    String         @id @default(cuid())
  materialId            String         @map("material_id")
  material              SourceMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  personId              String?        @map("person_id")
  person                Person?        @relation(fields: [personId], references: [id], onDelete: Cascade)
  personEventId         String?        @map("person_event_id")
  personEvent           PersonEvent?   @relation(fields: [personEventId], references: [id], onDelete: Cascade)
  createdAt             DateTime       @default(now()) @map("created_at")
  deletedAt             DateTime?      @map("deleted_at")
  deletedBy             String?        @map("deleted_by")
  deletionOperationId   String?        @map("deletion_operation_id")
  withdrawnAt           DateTime?      @map("withdrawn_at")
  withdrawnBy           String?        @map("withdrawn_by")
  withdrawalReason      String?        @map("withdrawal_reason")
  withdrawalOperationId String?        @map("withdrawal_operation_id")

  @@unique([materialId, personId], map: "uq_material_links_person")
  @@unique([materialId, personEventId], map: "uq_material_links_event")
  @@index([personId, deletedAt], map: "idx_material_links_person_active")
  @@index([personEventId, deletedAt], map: "idx_material_links_event_active")
  @@index([materialId, deletedAt], map: "idx_material_links_material_active")
  @@index([materialId, withdrawnAt], map: "idx_material_links_material_withdrawn")
  @@map("material_links")
}

model Relationship {
  id                    String    @id @default(cuid())
  type                  String
  personAId             String    @map("person_a_id")
  personBId             String    @map("person_b_id")
  label                 String?   @map("label")
  sortOrder             Int       @default(0) @map("sort_order")
  createdAt             DateTime  @default(now()) @map("created_at")
  personA               Person    @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personB               Person    @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             String?   @map("deleted_by")
  deletionOperationId   String?   @map("deletion_operation_id")
  withdrawnAt           DateTime? @map("withdrawn_at")
  withdrawnBy           String?   @map("withdrawn_by")
  withdrawalReason      String?   @map("withdrawal_reason")
  withdrawalOperationId String?   @map("withdrawal_operation_id")

  @@index([personAId, personBId, deletedAt], map: "idx_relationships_endpoints_deleted")
  @@index([personAId, personBId, withdrawnAt], map: "idx_relationships_endpoints_withdrawn")
  @@map("relationships")
}

model OperationBatch {
  id        String       @id @default(cuid())
  treeId    String       @map("tree_id")
  tree      FamilyTree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  actorId   String       @map("actor_id")
  action    String
  status    String       @default("complete")
  summary   Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  entries   AuditEntry[]

  @@index([treeId, createdAt], map: "idx_operation_batches_tree_created")
  @@map("operation_batches")
}

model AuditEntry {
  id         String         @id @default(cuid())
  batchId    String         @map("batch_id")
  batch      OperationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entityType String         @map("entity_type")
  entityId   String         @map("entity_id")
  action     String
  beforeJson Json?          @map("before_json")
  afterJson  Json?          @map("after_json")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([batchId], map: "idx_audit_entries_batch")
  @@index([entityType, entityId], map: "idx_audit_entries_entity")
  @@map("audit_entries")
}

model OperationConfirmation {
  id            String     @id @default(cuid())
  treeId        String     @map("tree_id")
  tree          FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId        String     @map("user_id")
  kind          String
  inputHash     String     @map("input_hash")
  revision      Int
  previewResult Json       @default("{}") @map("preview_result")
  consumed      Boolean    @default(false)
  expiresAt     DateTime   @map("expires_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([treeId, userId, kind, consumed], map: "idx_confirmations_lookup")
  @@index([expiresAt], map: "idx_confirmations_expires")
  @@map("operation_confirmations")
}

model FamilySnapshot {
  id                String     @id @default(cuid())
  treeId            String     @map("tree_id")
  tree              FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  reason            String
  version           Int        @default(1)
  sourceRevision    Int        @map("source_revision")
  creatorId         String     @map("creator_id")
  operationId       String?    @map("operation_id")
  snapshotJson      Json       @map("snapshot_json")
  personCount       Int        @default(0) @map("person_count")
  relationshipCount Int        @default(0) @map("relationship_count")
  eventCount        Int        @default(0) @map("event_count")
  materialCount     Int        @default(0) @map("material_count")
  fileCount         Int        @default(0) @map("file_count")
  createdAt         DateTime   @default(now()) @map("created_at")

  @@index([treeId, createdAt], map: "idx_snapshots_tree_created")
  @@map("family_snapshots")
}
